DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id
# Your server ID – commands appear instantly. Leave empty for global (slow to appear)
GUILD_ID=
# Your Discord user ID(s), comma separated. Only these users can run commands
OWNER_IDS=1250242285656997965
# ID used in the generated +vouch line (defaults to first OWNER_IDS)
VOUCH_ID=1250242285656997965
# Allowed underpayment before an invoice is flagged (0.02 = 2%)
PAY_TOLERANCE=0.02
# Where data.json is stored. Leave empty locally; set to your volume path when hosting (e.g. /data)
DATA_DIR=
